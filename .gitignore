# Local history and reference material must never be published.
/legacy/

# Machine settings, credentials and caches
.DS_Store
.env
.env.*
!.env.example
node_modules/
.venv/
__pycache__/
*.py[cod]
*.log
*.blend[1-9]

# Reproducible rendering intermediates
/site/work/*/_src/renders/
/site/work/*/_src/review/
/site/work/*/_src/_archive*/
/site/work/*/_src/renders_done.txt
